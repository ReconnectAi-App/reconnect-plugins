{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit SessionStart --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit SessionStart --runtime codex",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" inject-card --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" inject-card --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit UserPromptSubmit --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit UserPromptSubmit --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit PermissionRequest --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit PermissionRequest --runtime codex",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit SubagentStart --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit SubagentStart --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit SubagentStop --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit SubagentStop --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit PreCompact --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit PreCompact --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit Stop --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit Stop --runtime codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/cli.js\" emit SessionEnd --runtime codex",
            "commandWindows": "node \"%PLUGIN_ROOT%\\dist\\cli.js\" emit SessionEnd --runtime codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
